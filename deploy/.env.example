# Expose only to the local reverse proxy. Keep 127.0.0.1 for same-host Nginx/Caddy TLS.
APP_BIND_ADDRESS=127.0.0.1
REGISTRATION_MODE=invite
REGISTRATION_INVITE_CODES=replace-with-a-long-random-invitation-code
TRUST_PROXY=false

# Optional local OCR/speech sidecar. Leave blank to keep recognition disabled.
# When enabled, use the recognition compose profile and set a random 32+ char key.
RECOGNITION_WORKER_URL=
RECOGNITION_API_KEY=
RECOGNITION_WORKER_PORT=8001
RECOGNITION_TIMEOUT_MS=180000
RECOGNITION_MAX_FILE_SIZE_MB=10
RECOGNITION_MAX_AUDIO_SECONDS=60
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
