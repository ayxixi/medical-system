NODE_ENV=development
PORT=3000
DATABASE_URL="file:./dev.db"
FILE_STORAGE=local
UPLOAD_PATH=./uploads
MAX_FILE_SIZE_MB=10

# Authentication
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1d

# Required only when FILE_STORAGE=s3
# S3_REGION=us-east-1
# S3_BUCKET=my-bucket
# S3_ENDPOINT=                # optional, for S3-compatible services (MinIO etc.)
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_FORCE_PATH_STYLE=false   # set true for MinIO-style endpoints

# Authentication hardening
REGISTRATION_MODE=open
# Required when REGISTRATION_MODE=invite. Store codes securely in production.
# REGISTRATION_INVITE_CODES=one-time-code,another-code
LOGIN_MAX_ATTEMPTS=10
LOGIN_WINDOW_SECONDS=900
LOGIN_LOCKOUT_SECONDS=900
# Enable only behind a trusted reverse proxy. App trusts the nearest proxy.
TRUST_PROXY=false

# start.py fills these automatically for the local OCR/speech worker (Python venv; no Docker needed).
# To disable recognition for one run, use: python start.py --no-recognition
# RECOGNITION_WORKER_URL=http://127.0.0.1:8001
# RECOGNITION_API_KEY=replace-with-a-random-secret-at-least-32-characters
RECOGNITION_TIMEOUT_MS=180000
RECOGNITION_MAX_FILE_SIZE_MB=10

# 可选。仅支持本机或私有 IPv4，地址使用 OpenAI 兼容 API 基础路径。
# AI_MODELS_JSON='[{"id":"ollama","name":"本地模型","model":"qwen2.5:7b","baseUrl":"http://127.0.0.1:11434/v1"}]'
# 若模型要求密钥，将 apiKeyEnv 设为 AI_MODEL_KEY_OLLAMA，并配置同名变量。
# 可选：允许账号在「设定」中启用这些完整请求地址。多个地址用逗号分隔。
# AI_MODEL_ALLOWED_ENDPOINTS=http://127.0.0.1:11434/v1/chat/completions
