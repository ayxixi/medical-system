NODE_ENV=development
PORT=3000
DATABASE_URL="file:./dev.db"
FILE_STORAGE=local
UPLOAD_PATH=./uploads
MAX_FILE_SIZE_MB=10

# Authentication
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1d

# Required only when FILE_STORAGE=s3
# S3_REGION=us-east-1
# S3_BUCKET=my-bucket
# S3_ENDPOINT=                # optional, for S3-compatible services (MinIO etc.)
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_FORCE_PATH_STYLE=false   # set true for MinIO-style endpoints
